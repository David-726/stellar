---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---

<Base>
  <div class="with-sidebar">
    <Sidebar />
    <div class="content-main">
      <div class="intro-section">
        <div class="hero-frame">
          <img class="hero" data-hero-image src="/assets/images/hero.webp" alt="" width="1320" height="743" fetchpriority="high" />
        </div>
        <div class="bio-row">
          <img class="avatar" src="/assets/images/avatar.gif" alt={SITE.author} width="56" height="56" />
          <div>
            <p class="bio-name">{SITE.author}</p>
            <p class="bio-text">{SITE.bio}</p>
          </div>
        </div>
        <nav>
          {
            SITE.links.map((link) => (
              <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined}>
                {link.name}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="post-list">
        <h2 class="section-label">Posts</h2>
        {
          posts.map((post) => (
            <div class="post-item">
              <p class="post-item-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </p>
              <p class="post-item-meta">
                <time datetime={post.data.published.toISOString()}>{fmt(post.data.published)}</time>
                {post.data.tags.length > 0 && <span> · {post.data.tags.join(", ")}</span>}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>
