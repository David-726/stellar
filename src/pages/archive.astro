---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="归档">
  <div class="post-list">
    <h1 style="margin-top:0">归档</h1>
    {
      years.map((y) => (
        <section>
          <h2>{y}</h2>
          <ul style="list-style:none;padding:0">
            {byYear.get(y)!.map((post) => (
              <li style="margin-bottom:0.8em">
                <span style="font-family:var(--font-ui);font-size:0.78em;color:var(--core-gray);margin-right:12px">
                  {post.data.published.toISOString().slice(0, 10)}
                </span>
                <a href={`/posts/${post.id}/`} style="color:var(--core-black)">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
