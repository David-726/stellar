---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="归档">
  <div class="with-sidebar">
    <Sidebar />
    <div class="content-main">
      <div class="post-list">
        <h2 class="section-label" style="margin-top:0">Archive</h2>
        {
          years.map((y) => (
            <section>
              <h3 class="archive-year">{y}</h3>
              <ul class="archive-list">
                {byYear.get(y)!.map((post) => (
                  <li>
                    <span class="archive-date">
                      {post.data.published.toISOString().slice(0, 10)}
                    </span>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Base>
