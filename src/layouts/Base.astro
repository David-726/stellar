---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/noto-serif-sc";
import "@fontsource-variable/jetbrains-mono";
import { SITE } from "../consts";
import "../styles/site.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  readingProgress?: boolean;
}

const { title, description = SITE.description, readingProgress = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "home" },
  { href: "/archive/", label: "archive" },
  { href: "/about/", label: "about" },
];

const year = new Date().getFullYear();
const startYear = SITE.startDate;
const yearRange = year > startYear ? `${startYear}–${year}` : `${year}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      // 首帧前设定主题，避免闪烁；默认跟随系统
      (() => {
        let saved;
        try { saved = localStorage.getItem("theme"); } catch {}
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark" ? saved :
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="nav-logo">
          <img src="/assets/images/logo.png" alt="" width="30" height="30" />
          <span>{SITE.logo}</span>
        </a>
        <nav class="top-nav" aria-label="主导航">
          {
            navItems.map((item) => (
              <a href={item.href} class={currentPath === item.href ? "selected" : undefined} aria-current={currentPath === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            aria-label="切换明暗模式"
            title="切换明暗模式"
          >
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path></svg>
          </button>
        </nav>
      </div>
      {readingProgress && <div class="reading-progress" data-reading-progress aria-hidden="true"></div>}
    </header>

    <div class="main-container">
      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <nav>
          {
            SITE.links.map((link) => (
              <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
                {link.name}
              </a>
            ))
          }
        </nav>
        <p>
          © {yearRange}
          {SITE.author} · Powered by Astro
        </p>
      </footer>
    </div>

    <button class="back-to-top" data-back-to-top type="button" aria-label="返回顶部" aria-hidden="true" tabindex="-1" title="返回顶部">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v13"></path></svg>
    </button>

    <script>
      import "../scripts/motion";
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector(".theme-toggle");
        const system = matchMedia("(prefers-color-scheme: dark)");
        let transitionTimer;
        const updateLabel = () => {
          const label = root.dataset.theme === "dark" ? "切换到浅色模式" : "切换到深色模式";
          btn?.setAttribute("aria-label", label);
          btn?.setAttribute("title", label);
        };
        btn?.addEventListener("click", () => {
          clearTimeout(transitionTimer);
          root.classList.add("theme-transition");
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          updateLabel();
          transitionTimer = setTimeout(() => root.classList.remove("theme-transition"), 350);
        });
        system.addEventListener("change", (event) => {
          let saved;
          try { saved = localStorage.getItem("theme"); } catch {}
          if (saved === "light" || saved === "dark") return;
          root.dataset.theme = event.matches ? "dark" : "light";
          updateLabel();
        });
        updateLabel();
      })();
    </script>
  </body>
</html>
